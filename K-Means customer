      "source": [
        "# ============================================================\n",
        "# K-MEANS CLUSTERING - CUSTOMER SEGMENTATION\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD DATASET\n",
        "# ============================================================\n",
        "\n",
        "df = pd.read_csv(\"/content/Test.csv\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"DATASET INFORMATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Dataset Shape:\", df.shape)\n",
        "\n",
        "print(\"\\nFirst 5 Rows:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nColumns:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. CHECK MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MISSING VALUES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(df.isnull().sum())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. REMOVE ID COLUMN\n",
        "# ============================================================\n",
        "\n",
        "# ID is not useful for clustering\n",
        "if \"ID\" in df.columns:\n",
        "    df = df.drop(\"ID\", axis=1)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. HANDLE MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "# Numerical columns\n",
        "numerical_columns = df.select_dtypes(\n",
        "    include=[\"int64\", \"float64\"]\n",
        ").columns\n",
        "\n",
        "for column in numerical_columns:\n",
        "    df[column] = df[column].fillna(\n",
        "        df[column].median()\n",
        "    )\n",
        "\n",
        "\n",
        "# Categorical columns\n",
        "categorical_columns = df.select_dtypes(\n",
        "    include=[\"object\"]\n",
        ").columns\n",
        "\n",
        "for column in categorical_columns:\n",
        "    df[column] = df[column].fillna(\n",
        "        df[column].mode()[0]\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. CONVERT CATEGORICAL DATA TO NUMERICAL\n",
        "# ============================================================\n",
        "\n",
        "df_encoded = pd.get_dummies(\n",
        "    df,\n",
        "    columns=categorical_columns,\n",
        "    drop_first=True\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nEncoded Dataset Shape:\")\n",
        "print(df_encoded.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. FEATURE SCALING\n",
        "# ============================================================\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_scaled = scaler.fit_transform(\n",
        "    df_encoded\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. ELBOW METHOD\n",
        "# ============================================================\n",
        "\n",
        "inertia = []\n",
        "\n",
        "K = range(2, 11)\n",
        "\n",
        "for k in K:\n",
        "\n",
        "    kmeans = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10\n",
        "    )\n",
        "\n",
        "    kmeans.fit(X_scaled)\n",
        "\n",
        "    inertia.append(\n",
        "        kmeans.inertia_\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. ELBOW GRAPH\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.plot(\n",
        "    K,\n",
        "    inertia,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Number of Clusters (K)\")\n",
        "plt.ylabel(\"Inertia\")\n",
        "\n",
        "plt.title(\n",
        "    \"Elbow Method for Optimal K\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. SELECT NUMBER OF CLUSTERS\n",
        "# ============================================================\n",
        "\n",
        "# Change this value based on your Elbow graph\n",
        "optimal_k = 4\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. K-MEANS MODEL\n",
        "# ============================================================\n",
        "\n",
        "kmeans = KMeans(\n",
        "    n_clusters=optimal_k,\n",
        "    random_state=42,\n",
        "    n_init=10\n",
        ")\n",
        "\n",
        "clusters = kmeans.fit_predict(\n",
        "    X_scaled\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. ADD CLUSTER TO DATASET\n",
        "# ============================================================\n",
        "\n",
        "df[\"Cluster\"] = clusters\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. SILHOUETTE SCORE\n",
        "# ============================================================\n",
        "\n",
        "silhouette = silhouette_score(\n",
        "    X_scaled,\n",
        "    clusters\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"K-MEANS RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"Number of Clusters:\",\n",
        "    optimal_k\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Silhouette Score:\",\n",
        "    round(silhouette, 4)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. CLUSTER DISTRIBUTION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nCluster Distribution:\")\n",
        "\n",
        "print(\n",
        "    df[\"Cluster\"].value_counts().sort_index()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 14. CLUSTER SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CLUSTER SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    df.groupby(\"Cluster\")[\n",
        "        numerical_columns\n",
        "    ].mean()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. CLUSTER GRAPH\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(10, 7))\n",
        "\n",
        "plt.scatter(\n",
        "    df[\"Age\"],\n",
        "    df[\"Family_Size\"],\n",
        "    c=df[\"Cluster\"],\n",
        "    cmap=\"viridis\",\n",
        "    s=40\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Family Size\")\n",
        "\n",
        "plt.title(\n",
        "    \"K-Means Customer Segmentation\"\n",
        ")\n",
        "\n",
        "plt.colorbar(\n",
        "    label=\"Cluster\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 16. SPENDING SCORE GRAPH\n",
        "# ============================================================\n",
        "\n",
        "# Convert Spending Score to numerical value\n",
        "spending_mapping = {\n",
        "    \"Low\": 1,\n",
        "    \"Average\": 2,\n",
        "    \"High\": 3\n",
        "}\n",
        "\n",
        "if \"Spending_Score\" in df.columns:\n",
        "\n",
        "    spending_numeric = df[\n",
        "        \"Spending_Score\"\n",
        "    ].map(spending_mapping)\n",
        "\n",
        "    plt.figure(figsize=(10, 6))\n",
        "\n",
        "    plt.scatter(\n",
        "        df[\"Age\"],\n",
        "        spending_numeric,\n",
        "        c=df[\"Cluster\"],\n",
        "        cmap=\"viridis\",\n",
        "        s=40\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\"Age\")\n",
        "    plt.ylabel(\"Spending Score\")\n",
        "\n",
        "    plt.title(\n",
        "        \"Age vs Spending Score by Cluster\"\n",
        "    )\n",
        "\n",
        "    plt.colorbar(\n",
        "        label=\"Cluster\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 17. SAVE CLUSTERED DATASET\n",
        "# ============================================================\n",
        "\n",
        "df.to_csv(\n",
        "    \"kmeans_customer_segments.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"FILE SAVED\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"kmeans_customer_segments.csv created successfully.\"\n",
        ")"
      ],
